<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Your Order is Ready!</title>
</head>
<body style="margin: 0; padding: 0; background-color: #f5f5f4; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; -webkit-text-size-adjust: 100%;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color: #f5f5f4;">
    <tr>
      <td align="center" style="padding: 32px 16px;">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width: 560px; margin: 0 auto;">

          <%# Restaurant header %>
          <tr>
            <td style="background-color: <%= @restaurant.primary_color || '#16a34a' %>; padding: 24px 28px; border-radius: 12px 12px 0 0;">
              <h1 style="margin: 0; font-size: 22px; font-weight: 700; color: #ffffff;">
                <%= @restaurant.name %>
              </h1>
              <% if @restaurant.address.present? %>
                <p style="margin: 6px 0 0; font-size: 13px; color: rgba(255,255,255,0.8);">
                  <%= @restaurant.address %>
                </p>
              <% end %>
            </td>
          </tr>

          <%# Main content %>
          <tr>
            <td style="background-color: #ffffff; padding: 28px;">

              <%# Ready notification - prominent green banner %>
              <div style="background-color: #dcfce7; border-radius: 12px; padding: 20px 24px; margin-bottom: 24px; text-align: center;">
                <h2 style="margin: 0 0 6px; font-size: 24px; font-weight: 700; color: #166534;">
                  Your Order is Ready!
                </h2>
                <p style="margin: 0; font-size: 15px; color: #15803d;">
                  Order #<%= @order.id %> is waiting for you
                </p>
              </div>

              <%# Personalized message %>
              <p style="margin: 0 0 20px; font-size: 15px; color: #525252; line-height: 1.5;">
                Hi <strong><%= @order.customer_name %></strong>! Great news — your order is ready for pickup. Head over to grab it while it's fresh!
              </p>

              <%# Order summary box %>
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color: #fafaf9; border-radius: 8px; margin-bottom: 20px;">
                <tr>
                  <td style="padding: 16px;">
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                      <tr>
                        <td style="font-size: 12px; font-weight: 600; color: #a8a29e; text-transform: uppercase; letter-spacing: 0.5px; padding-bottom: 8px;">
                          Order Summary
                        </td>
                        <td align="right" style="font-size: 12px; font-weight: 600; color: #a8a29e; text-transform: uppercase; letter-spacing: 0.5px; padding-bottom: 8px;">
                          #<%= @order.id %>
                        </td>
                      </tr>
                    </table>

                    <%# Items list %>
                    <% @items.each do |item| %>
                      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-top: 1px solid #e7e5e4;">
                        <tr>
                          <td style="padding: 8px 0;">
                            <span style="font-size: 14px; color: #171717;">
                              <%= item.quantity %>&times; <%= item.menu_item.name %>
                            </span>
                            <% if item.order_item_modifiers.any? %>
                              <span style="font-size: 12px; color: #a8a29e;">
                                (<%= item.order_item_modifiers.map { |m| m.modifier.name }.join(", ") %>)
                              </span>
                            <% end %>
                          </td>
                        </tr>
                      </table>
                    <% end %>

                    <%# Total %>
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-top: 2px solid #d6d3d1;">
                      <tr>
                        <td style="padding-top: 10px;">
                          <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                            <tr>
                              <td style="font-size: 15px; font-weight: 700; color: #171717;">
                                Total Paid
                              </td>
                              <td align="right" style="font-size: 15px; font-weight: 700; color: #171717;">
                                $<%= "%.2f" % @order.total %>
                              </td>
                            </tr>
                          </table>
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>
              </table>

              <%# Pickup location %>
              <% if @restaurant.address.present? %>
                <div style="background-color: #f0f9ff; border-radius: 8px; padding: 14px 16px; margin-bottom: 20px;">
                  <p style="margin: 0 0 4px; font-size: 12px; font-weight: 600; color: #0369a1; text-transform: uppercase; letter-spacing: 0.5px;">
                    Pickup Location
                  </p>
                  <p style="margin: 0; font-size: 14px; color: #0c4a6e; font-weight: 500;">
                    <%= @restaurant.address %>
                  </p>
                </div>
              <% end %>

              <%# Contact info %>
              <p style="margin: 0; font-size: 13px; color: #a8a29e; line-height: 1.5;">
                Questions? Call us at
                <% if @restaurant.phone.present? %>
                  <a href="tel:<%= @restaurant.phone %>" style="color: <%= @restaurant.primary_color || '#16a34a' %>; text-decoration: none; font-weight: 600;">
                    <%= @restaurant.phone %>
                  </a>
                <% else %>
                  the restaurant directly
                <% end %>
              </p>

            </td>
          </tr>

          <%# Footer %>
          <tr>
            <td style="padding: 20px 28px; text-align: center; border-radius: 0 0 12px 12px; background-color: #fafaf9;">
              <p style="margin: 0; font-size: 12px; color: #a8a29e;">
                &copy; <%= Date.today.year %> <%= @restaurant.name %>. Thanks for your order!
              </p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
