<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Order Confirmation</title>
</head>
<body style="margin: 0; padding: 0; background-color: #f5f5f4; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; -webkit-text-size-adjust: 100%;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color: #f5f5f4;">
    <tr>
      <td align="center" style="padding: 32px 16px;">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width: 560px; margin: 0 auto;">

          <%# Restaurant header %>
          <tr>
            <td style="background-color: <%= @restaurant.primary_color || '#1a1a1a' %>; padding: 24px 28px; border-radius: 12px 12px 0 0;">
              <h1 style="margin: 0; font-size: 22px; font-weight: 700; color: #ffffff;">
                <%= @restaurant.name %>
              </h1>
              <% if @restaurant.address.present? %>
                <p style="margin: 6px 0 0; font-size: 13px; color: rgba(255,255,255,0.8);">
                  <%= @restaurant.address %>
                </p>
              <% end %>
            </td>
          </tr>

          <%# Main content %>
          <tr>
            <td style="background-color: #ffffff; padding: 28px;">

              <%# Confirmation message %>
              <h2 style="margin: 0 0 4px; font-size: 20px; font-weight: 700; color: #171717;">
                Order Confirmed
              </h2>
              <p style="margin: 0 0 20px; font-size: 14px; color: #737373;">
                Thank you, <strong><%= @order.customer_name %></strong>! Your order #<%= @order.id %> has been received.
              </p>

              <%# Order details box %>
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color: #fafaf9; border-radius: 8px; margin-bottom: 20px;">
                <tr>
                  <td style="padding: 16px;">
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                      <tr>
                        <td style="font-size: 12px; font-weight: 600; color: #a8a29e; text-transform: uppercase; letter-spacing: 0.5px; padding-bottom: 8px;">
                          Order #<%= @order.id %>
                        </td>
                        <td align="right" style="font-size: 12px; font-weight: 600; color: #a8a29e; text-transform: uppercase; letter-spacing: 0.5px; padding-bottom: 8px;">
                          <%= @order.order_type.titleize.gsub('_', ' ') %>
                        </td>
                      </tr>
                    </table>

                    <%# Items %>
                    <% @items.each do |item| %>
                      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-top: 1px solid #e7e5e4;">
                        <tr>
                          <td style="padding: 10px 0;">
                            <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                              <tr>
                                <td style="font-size: 14px; font-weight: 600; color: #171717;">
                                  <%= item.quantity %>&times; <%= item.menu_item.name %>
                                </td>
                                <td align="right" style="font-size: 14px; color: #57534e;">
                                  $<%= "%.2f" % item.subtotal %>
                                </td>
                              </tr>
                            </table>
                            <% if item.order_item_modifiers.any? %>
                              <p style="margin: 3px 0 0; font-size: 12px; color: #a8a29e; padding-left: 16px;">
                                <%= item.order_item_modifiers.map { |m| m.modifier.name }.join(", ") %>
                              </p>
                            <% end %>
                            <% if item.special_instructions.present? %>
                              <p style="margin: 3px 0 0; font-size: 12px; color: #d97706; padding-left: 16px;">
                                Note: <%= item.special_instructions %>
                              </p>
                            <% end %>
                          </td>
                        </tr>
                      </table>
                    <% end %>

                    <%# Total %>
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-top: 2px solid #d6d3d1;">
                      <tr>
                        <td style="padding-top: 12px;">
                          <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                            <tr>
                              <td style="font-size: 16px; font-weight: 700; color: #171717;">
                                Total
                              </td>
                              <td align="right" style="font-size: 16px; font-weight: 700; color: #171717;">
                                $<%= "%.2f" % @order.total %>
                              </td>
                            </tr>
                          </table>
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>
              </table>

              <% if @order.special_instructions.present? %>
                <div style="background-color: #fef3c7; border-radius: 8px; padding: 12px 16px; margin-bottom: 20px;">
                  <p style="margin: 0; font-size: 13px; color: #92400e;">
                    <strong>Special Instructions:</strong> <%= @order.special_instructions %>
                  </p>
                </div>
              <% end %>

              <%# Estimated ready time %>
              <div style="background-color: #f0fdf4; border-radius: 8px; padding: 12px 16px; margin-bottom: 16px;">
                <p style="margin: 0; font-size: 14px; color: #166534; font-weight: 600;">
                  Estimated Ready Time: 15-25 minutes
                </p>
              </div>

              <%# Contact info %>
              <p style="margin: 0; font-size: 13px; color: #a8a29e; line-height: 1.5;">
                Questions about your order? Call us at
                <% if @restaurant.phone.present? %>
                  <a href="tel:<%= @restaurant.phone %>" style="color: <%= @restaurant.primary_color || '#171717' %>; text-decoration: none; font-weight: 600;">
                    <%= @restaurant.phone %>
                  </a>
                <% else %>
                  the restaurant directly
                <% end %>
              </p>

            </td>
          </tr>

          <%# Footer %>
          <tr>
            <td style="padding: 20px 28px; text-align: center; border-radius: 0 0 12px 12px; background-color: #fafaf9;">
              <p style="margin: 0; font-size: 12px; color: #a8a29e;">
                &copy; <%= Date.today.year %> <%= @restaurant.name %>. All rights reserved.
              </p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
